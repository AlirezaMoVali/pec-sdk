{
  "name": "pec-sdk",
  "version": "1.1.0",
  "description": "TypeScript SDK for PEC (Parsian Electronic Commerce) payment gateway.",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/postbuild-esm.mjs",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Alireza Mohammadvali <a.mv99@outlook.com> (https://github.com/AlirezaMoVali)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.4.4"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "soap": "^1.1.7"
  },
  "files": [
    "dist"
  ]
}
